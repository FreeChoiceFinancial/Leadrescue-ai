# LeadRescue AI — copy to .env.local and fill in. Never commit real values.
# Every integration runs in labeled sandbox mode when its variables are empty.

# --- Supabase (Auth, Postgres, RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is accepted if the publishable key is unset:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy service-role key is accepted if the secret key is unset:
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required in production for cron routes. Generate a long random string.
CRON_SECRET=
# Set to 1 only if you intentionally want unsigned sandbox webhooks in production.
LEADRESCUE_ALLOW_SANDBOX_WEBHOOKS=

# --- Twilio (voice + SMS). Per-client A2P 10DLC brand/campaign required before live sends. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public URLs exactly as configured in the Twilio console (used to verify signatures).
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_SMS_WEBHOOK_URL=
# Trust Hub / A2P brand and campaign submission. Leave unset.
# DEMO_MODE or PUBLIC_DEMO forces sandbox even if this is true.
# This build does not call Twilio Trust Hub. The 10DLC form stores a review request only.
A2P_SUBMIT_LIVE=

# --- CRM (HubSpot and Zoho). Leave CRM_LIVE unset or false. ---
# DEMO_MODE or PUBLIC_DEMO forces mock adapters and the "Coming soon / sandbox" label.
# CRM_TOKEN_KEY is 32 bytes, base64. Generate with: openssl rand -base64 32
# Do not put secrets in this file.
CRM_LIVE=
CRM_TOKEN_KEY=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# --- OpenAI-compatible chat completions. ---
# Set DEMO_MODE=true (or PUBLIC_DEMO=true) on the public demo. Either flag
# refuses real LLM calls even if LLM_LIVE=true.
# Netlify AI Gateway may inject OPENAI_API_KEY. That key is ignored unless
# demo mode is off and LLM_LIVE=true.
DEMO_MODE=
PUBLIC_DEMO=
LLM_LIVE=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Google Calendar OAuth (free/busy + event insert). Absent = demo slots, labeled sandbox. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Email (Resend) for owner escalation and weekly reports. Absent = sandbox log only. ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Stripe test mode. Use sk_test_ / whsec_ / price_ from the Stripe test dashboard. ---
# Create the prices in the test dashboard. This app refuses sk_live_ and does not create products.
# Annual prices are a 12-month commitment: Starter $93/mo ($1,116/yr), Growth $174/mo ($2,088/yr), Pro $312/mo ($3,744/yr).
# Month-to-month is Starter $149, Growth $279, Pro $499. Setup is $99 on month-to-month and $0 on annual. Overage is $0.40.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_SETUP=
STRIPE_PRICE_OVERAGE=
